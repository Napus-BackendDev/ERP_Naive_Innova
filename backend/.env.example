PORT=5000
MONGODB_URI=
JWT_SECRET=
CLIENT_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
# Public HTTPS backend origin used by buttons opened from Gmail on another device.
# Example: https://naive-ops-backend.onrender.com
APPROVAL_BASE_URL=
GOOGLE_CLIENT_ID=
