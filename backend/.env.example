# Local UI testing only. Keep false in Production.
ENABLE_MOCK_LOGIN=false

# Gmail sender account. Use a Google App Password, never the account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Gmail addresses that receive first-login approval requests, comma-separated.
