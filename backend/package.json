    "passport-google-oauth20": "^2.0.0",
    "puppeteer-core": "^25.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.2",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
